# ==============================================================
# LOGIXT SaaS — Plantilla de Configuración de Entorno
# ==============================================================
# Copie este archivo como .env y complete los valores correspondientes
# para su entorno de despliegue.

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Puerto del servidor (en plataformas como Render o Railway se inyecta automáticamente)
PORT=5000

# URL pública del cliente para políticas de CORS
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com (o el dominio asignado por su proveedor)
CLIENT_URL=https://lo-gixt-app.vercel.app

# Secreto criptográfico para firma de JWT (OBLIGATORIO Y CRÍTICO EN PRODUCCIÓN)
# Genere una clave segura de al menos 32 caracteres (ej: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_SEGURO_EN_PRODUCCION

# Ruta a la base de datos SQLite (Opcional)
# Útil cuando se usa un volumen persistente en hosting cloud (ej: /var/data/database.sqlite)
# Si no se especifica, se ubica por defecto en el directorio raíz del servidor
DB_PATH=database.sqlite

# Directorio persistente para respaldos JSON (opcional; por defecto server/backups)
# BACKUPS_DIR=/var/data/logixt-backups

# Control de sembrado de datos de demostración ('true' | 'false')
# En producción DEBE ser 'false' para no crear empresas ni pagos simulados.
SEED_DEMO_DATA=false

# Contraseña inicial para el usuario SuperAdmin en la primera instalación
# Use una clave única y fuerte solo durante la inicialización, o déjela vacía
# para que se genere una clave aleatoria de un solo uso.
SUPERADMIN_INITIAL_PASSWORD=

# Firebase Authentication: el JSON de cuenta de servicio es privado.
# Configúrelo únicamente como variable secreta en el backend de producción.
FIREBASE_PROJECT_ID=logixt-59b8c
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Drive OAuth (opcional)
# Configure un cliente OAuth Web en Google Cloud y añada esta URI exacta como redirect URI autorizada.
# GOOGLE_OAUTH_REDIRECT_URI=https://api.tu-dominio.com/api/storage/google-drive/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Clave AES-256 para cifrar access/refresh tokens en SQLite. Genere con: openssl rand -hex 32
# Guárdela en el gestor de secretos del despliegue. Si se pierde, los tokens guardados no se podrán descifrar.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
